{
  "name": "claude-village",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "claude-village": "./dist/bin/claude-village.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run sprites:export && tsc -p tsconfig.json && vite build",
    "dev:server": "tsx watch bin/claude-village.ts start",
    "dev:client": "npm run sprites:export && vite",
    "dev:sandbox": "tsx scripts/sandbox.ts",
    "sprites:export": "tsx scripts/exportSprites.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p src/client/tsconfig.json"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/seedrandom": "^3.0.8",
    "canvas": "^3.2.3",
    "eventsource": "^5.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "better-sse": "^0.16.1",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "phaser": "^3.90.0",
    "seedrandom": "^3.0.5",
    "zod": "^4.6.5"
  }
}

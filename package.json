    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "better-sse": "^0.16.1",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  }
}

{
  "name": "claude-village",
  "version": "0.1.0",
  "description": "Watch your Claude Code sessions work as a pixel-art village",
  "keywords": [
    "claude",
    "claude-code",
    "hooks",
    "dashboard",
    "phaser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yognevoy/claude-village.git"
  },
  "bugs": {
    "url": "https://github.com/yognevoy/claude-village/issues"
  },
  "homepage": "https://github.com/yognevoy/claude-village#readme",
  "type": "module",
  "bin": {
    "claude-village": "./dist/bin/claude-village.js"
  },
  "files": [
    "dist/bin",
    "dist/src/hook",
    "dist/src/infrastructure",
    "dist/src/domain",
    "dist/src/shared",
    "dist/client"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "prepublishOnly": "npm run build",
    "dev:server": "tsx watch bin/claude-village.ts start",
    "dev:client": "vite",
    "dev:sandbox": "tsx scripts/sandbox.ts",
    "sprites:export": "tsx scripts/vendor/exportSprites.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p src/client/tsconfig.json"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/seedrandom": "^3.0.8",
    "canvas": "^3.2.3",
    "eventsource": "^5.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "better-sse": "^0.16.1",
    "commander": "^15.0.0",
    "express": "^5.2.1",
    "phaser": "^3.90.0",
    "seedrandom": "^3.0.5",
    "zod": "^4.6.5"
  }
}
